; seed.kb -- a placeholder pocket of knowing, in Cyc's shape, written by hand. The skeleton (kinds, glosses, words,
; disjoints) is what a stripped OWL will replace; the rules, defaults and worlds below it are hand-woven and stay.
;   (genls X Y)  every X is a Y          (isa X Y)  X is one Y           (comment X "...")   (word X "spoken" ...)
;   (mass X)     no article: furniture   (disjoint X Y)  nothing is both an X and a Y
;   (default (X ?x) => (p ?x) ...)       Xs p, unless (except Z p ...)   the nearest word wins
;   (rule (T ?x) (c ?x) => (p ?x) ...)   when a T is c, it p: a commonsense step, chained
;   (in-mt M form ...)  a world          (genlMt M N)  M sees N           (mt-word M "w" ...)  "let's talk about w"

; ---- the skeleton
(genls Individual Thing) (genls Collection Thing)
(genls SpatialThing Individual) (genls PartiallyTangible SpatialThing) (genls Artifact PartiallyTangible)
(genls Organism PartiallyTangible) (genls Animal Organism) (genls Plant Organism)
(genls Bird Animal) (genls Mammal Animal) (genls Fish Animal) (genls Insect Animal)
(genls Dog Mammal) (genls Cat Mammal) (genls Horse Mammal) (genls Person Mammal)
(genls Sparrow Bird) (genls Gull Bird) (genls Penguin Bird) (genls Falcon Bird) (genls Ostrich Bird)
(genls Tree Plant) (genls Flower Plant) (genls Columbine Flower)

(genls Substance PartiallyTangible) (genls Liquid Substance) (genls Water Liquid) (genls Milk Liquid) (genls Tea Liquid)
(genls Container Artifact) (genls Cup Container) (genls Bucket Container) (genls Kettle Container) (genls Vase Container)
(genls Furniture Artifact) (genls Seat Furniture) (genls Chair Seat) (genls Stool Seat) (genls Sofa Seat) (genls Bench Seat)
(genls Table Furniture) (genls Desk Table) (genls Bed Furniture) (genls Wardrobe Furniture) (genls Bookcase Furniture)
(genls Vehicle Artifact) (genls Truck Vehicle) (genls DumpTruck Truck) (genls Boat Vehicle) (genls Car Vehicle) (genls Spacecraft Vehicle)
(genls Tool Artifact) (genls Hammer Tool) (genls TireIron Tool) (genls Computer Artifact) (genls Game Artifact)
(genls Instrument Artifact) (genls Horn Instrument)

(isa Nuage Computer)

(disjoint Organism Artifact) (disjoint Animal Plant) (disjoint Organism Substance) (disjoint Artifact Substance)
(disjoint Bird Fish) (disjoint Bird Mammal) (disjoint Fish Mammal) (disjoint Insect Bird) (disjoint Insect Mammal)
(disjoint Furniture Vehicle) (disjoint Furniture Container) (disjoint Tool Furniture)

(comment Thing "everything there is")
(comment Furniture "a movable thing for living with: to sit on, eat at, sleep in or keep things in")
(comment Seat "something made to be sat on")
(comment Chair "a seat for one person, with a back")
(comment Stool "a seat with no back and no arms")
(comment Sofa "a long, soft seat for several people")
(comment Table "furniture with a flat top on legs")
(comment Bird "an animal with feathers and wings that lays eggs")
(comment Penguin "a bird that swims and does not fly")
(comment Columbine "a flower whose spurs look like five doves around a dish")
(comment DumpTruck "a truck whose bed tips to drop its load")
(comment Container "a thing made to hold other things")
(comment Liquid "a substance that flows and takes the shape of what holds it")
(comment Nuage "a small cloud that chats: a few kilobytes of the old ways")

(mass Furniture) (mass Water) (mass Milk) (mass Tea) (mass Air) (mass Capsaicin) (mass Curry)
(word Person "person" "people" "man" "woman")
(word Bed "bed" "beds")
(word DumpTruck "dumptruck" "dump truck")

; ---- defaults: what kinds of things usually do, and the exceptions nearer down
(default (Bird ?x) => (flies ?x) (has-feathers ?x) (lays-eggs ?x))
(except Penguin flies) (except Ostrich flies)
(except Animal flies)   ; most animals do not fly; the nearer word wins, so birds and insects still do
(default (Insect ?x) => (flies ?x))
(default (Penguin ?x) => (swims ?x))
(default (Fish ?x) => (swims ?x) (has-gills ?x))
(default (Mammal ?x) => (has-fur ?x) (breathes-air ?x))
(except Person has-fur)
(default (Plant ?x) => (needs-light ?x))
(default (Seat ?x) => (can-be-sat-on ?x))
(default (Vehicle ?x) => (carries-things ?x))

; ---- rules: the commonsense step (naive physics, kitchen and garden)
(rule (Liquid ?x) (heated ?x) => (may-boil ?x))
(rule (Liquid ?x) (may-boil ?x) => (gives-off-steam ?x))
(rule (Liquid ?x) (cooled ?x) => (may-freeze ?x))
(rule (Liquid ?x) (may-freeze ?x) => (turns-to-ice ?x))
(rule (Container ?x) (broken ?x) => (leaks ?x))
(rule (Container ?x) (has-a-hole ?x) => (leaks ?x))
(rule (Container ?x) (leaks ?x) => (cannot-hold-water ?x))
(rule (PartiallyTangible ?x) (dropped ?x) => (falls ?x))
(rule (Container ?x) (falls ?x) => (may-break ?x))
(rule (Seat ?x) (broken ?x) => (cannot-be-sat-on ?x))
(rule (Vehicle ?x) (out-of-fuel ?x) => (stops ?x))
(rule (Organism ?x) (unfed ?x) => (grows-hungry ?x))
(rule (Plant ?x) (watered ?x) => (grows ?x))
(rule (Plant ?x) (kept-in-the-dark ?x) => (wilts ?x))

; ---- worlds
(comment ApolloMt "the landing, the loop, and the two spacecraft")
(mt-word ApolloMt "apollo" "apollo 11" "the moon" "the landing" "space")
(in-mt ApolloMt
  (isa Eagle Spacecraft) (isa Columbia Spacecraft)
  (comment Eagle "the lunar module that landed at Tranquility")
  (comment Columbia "the command module that circled overhead")
  (default (Spacecraft ?x) => (flies ?x))
  (rule (Spacecraft ?x) (out-of-fuel ?x) => (must-abort ?x))
  (rule (Spacecraft ?x) (has-a-1202-alarm ?x) => (is-go-on-that-alarm ?x)))

(comment FictionMt "stories, games, and the demo's own legends")
(mt-word FictionMt "fiction" "stories" "the demo" "stickey furniture" "games")
(in-mt FictionMt
  (isa SirDumptruck DumpTruck)
  (comment SirDumptruck "the one who flattens fine pixel furniture")
  (word SirDumptruck "sir dumptruck" "sirdumptruck")
  (default (Furniture ?x) => (flaps ?x))
  (rule (Furniture ?x) (met-by-sir-dumptruck ?x) => (is-flattened ?x)))

(comment HypotheticalMt "what has not happened in this timeline")
(mt-word HypotheticalMt "the hypothetical" "hypothetical" "hypotheticals" "what might have been" "another timeline")
(in-mt HypotheticalMt
  (genls Flumbleboat Coracle)
  (comment Flumbleboat "a word that has not happened in this timeline. Perhaps it was one man's mocking name for a coracle, until he was shown how well a boat with no keel fishes along a shore, and learned its real name")
  (isa Exaspera TelevisionProgram) (word Exaspera "exaspera" "the exaspera")
  (comment Exaspera "a public-television space series of 1977 that never existed. It ran one season, low in budget, high in concept, and tight in costume, and ended when major foundations intervened. It followed one ship into the equiperilous dimensions of language. Its Director's Non-cut is still assembling itself")
  (genls Sontimeter Instrument) (word Sontimeter "sontimeter" "sontimeters")
  (comment Sontimeter "the Captain's private word, never told to anyone, for the three dials and one light in the upper right of the Space Status panels. A simple read")
  (prop Sontimeter measures "whatever its three dials and one light say. The Captain knew, and no one else on the bridge, or off it")
  (why Sontimeter "it was the Captain's private word, so the enemy captain, goggling on the main viewer, could not answer it"))

; ---- from user1's answers to Nuage's hanging questions (3 xi 2026)
(genls Zebra Mammal) (comment Zebra "a wild horse of Africa, striped black and white")
(genls Quagga Zebra) (comment Quagga "a zebra of southern Africa, striped at the front and plain brown behind, gone since 1883. Its pelt shows, in one animal, a full field of stripes fading into none")
(genls Coracle Boat)
(genls ImaginaryUnit ComplexNumber) (word ImaginaryUnit "imaginary unit" "imaginary number" "imaginary numbers") (unique ImaginaryUnit)
(genls Imagination Thinking) (mass Imagination) (comment Imagination "the power to picture what is not before the senses: the absent, the past, the possible, and what will never be")
(comment ImaginaryUnit "the number that turns another a quarter-turn. Its square is minus one. Descartes called it imaginary, half in scorn, yet alternating current and quantum mechanics both need it")
(genls Interscintillation Conversation) (word Interscintillation "interscintillation" "interscintillative")
(comment Interscintillation "a conversation in sparks, as between two boats by Aldis lamp, each word answered with a flash. Its word is User1's coinage, from Latin scintilla, a spark")
(why Interscintillation "both lamps flash all through a message: one sends the words, and the other answers each with a single long flash, which means received") (comment Coracle "a small round boat with no keel, light enough to carry on the back, for fishing close to the shore")

; ---- commonsense, woven by hand from the first challenge set (patty/challenge.txt, 2 xi 2026)
(genls Bicycle Vehicle) (comment Bicycle "a vehicle with two wheels, moved by pedals")
(genls Ice Substance) (mass Ice) (comment Ice "water frozen solid")
(genls Tomato Fruit) (comment Tomato "a red fruit, as a botanist counts, eaten as a vegetable")
(genls DrinkingGlass Container) (word DrinkingGlass "glass" "glasses" "drinking glass")
(genls Day Date) (genls Hour Date) (genls Minute Date)
(disjoint Spider Insect) (comment Spider "an animal with eight legs, which is not an insect")
(mass Grass) (mass Snow) (mass Blood) (mass Water) (mass Fire) (mass Music)
(why Sky "sunlight is scattered by the air, and blue light, with its short waves, is scattered most of all")
(why Ice "water freezes into a solid when it is colder than its freezing point")

(has Mammal "four legs") (has Person "two legs and two arms") (has Bird "two legs and two wings") (has Insect "six legs")
(has Spider "eight legs") (has Whale "flippers, and no legs") (has Fish "fins, and no legs") (has Snake "no legs")
(has Car "four wheels") (has Bicycle "two wheels") (has Truck "four or more wheels") (has Boat "a hull, and no wheels")
(has Week "seven days") (has Day "twenty-four hours") (has Hour "sixty minutes") (has Minute "sixty seconds")
(has Year "twelve months, and 365 days (366 in a leap year)") (has Tree "roots, a trunk, branches, and leaves")

(prop Sky colour "blue by day, and dark at night") (prop Grass colour "green") (prop Snow colour "white") (prop Blood colour "red")
(prop Sun colour "yellow-white") (prop Water colour "clear") (prop Fire colour "orange, yellow, and red") (prop Tomato colour "red when ripe")
(prop Ice temperature "cold") (prop Snow temperature "cold") (prop Fire temperature "hot") (prop Sun temperature "very hot")
(prop Tree material "wood") (prop Furniture material "wood, metal, or plastic") (prop DrinkingGlass material "glass") (prop Ice material "water")
(prop Animal eats "plants, or other animals") (prop Cow eats "grass and hay") (prop Horse eats "grass and hay") (prop Cat eats "meat and fish")
(prop Bird eats "seeds, insects, or fish") (prop Person eats "almost anything")
(prop Fish lives "in water") (prop Whale lives "in the sea") (prop Bird lives "in nests, in trees and hedges") (prop Penguin lives "on cold coasts and sea ice, mostly in the far south") (prop Penguin eats "fish, squid, and krill") (prop Person lives "in houses and homes")
(prop Doctor does "treats people who are ill or hurt") (prop Teacher does "helps people learn")

(default (Bat ?x) => (flies ?x))
(default (Mammal ?x) => (walks ?x)) (except Whale walks) (except Bat walks)
(default (Person ?x) => (talks ?x)) (except Animal talks)
(except Artifact walks) (except Artifact talks) (except Artifact flies) (default (Aircraft ?x) => (flies ?x)) (default (Spacecraft ?x) => (flies ?x))
(default (Boat ?x) => (floats ?x)) (default (Wood ?x) => (floats ?x))

(rule (Ice ?x) (heated ?x) => (melts ?x))
(rule (Ice ?x) (melts ?x) => (turns-to-water ?x))
(rule (Liquid ?x) (spilled ?x) => (makes-a-puddle ?x))
(rule (Artifact ?x) (dropped ?x) => (falls ?x))
(rule (DrinkingGlass ?x) (falls ?x) => (may-shatter ?x))
(rule (Plant ?x) (no-water ?x) => (wilts ?x))
(rule (Plant ?x) (wilts ?x) => (may-die ?x))

(opposite hot cold) (opposite big small) (opposite up down) (opposite day night) (opposite wet dry) (opposite light dark)
(opposite fast slow) (opposite old young) (opposite happy sad) (opposite open closed) (opposite full empty) (opposite in out)
(opposite yes no) (opposite black white) (opposite good bad) (opposite early late) (opposite heavy light) (opposite high low)
(opposite long short) (opposite hard soft) (opposite loud quiet) (opposite sweet sour) (opposite left right) (opposite win lose)
; the kitchen and the studio, asked about by Gemma's pupils: spicy curry, watercolour, a crescendo
(genls Curry PreparedFood) (word Curry "curry" "curries")
(comment Curry "a dish of meat, fish, or vegetables cooked in a sauce of spices, from India and the lands around it")
(genls ChiliPepper FoodItem) (word ChiliPepper "chili pepper" "chili peppers") (word ChiliPepper "chili" "chilies") (word ChiliPepper "chilli" "chillies")
(comment ChiliPepper "the hot fruit of a pepper plant. Its heat comes from capsaicin, an oil the tongue feels as burning")
(why ChiliPepper "capsaicin touches the nerves on the tongue that sense heat, so the mouth feels a burn with no fire in it")
(genls Capsaicin Substance) (word Capsaicin "capsaicin")
(comment Capsaicin "the oil in chili peppers that makes them hot. It does not dissolve in water, which is why water does little for the burn")
(comment Milk "a white liquid that mammals make for their young. A drink of it soothes the heat of chili and spicy food, because its fat and its casein carry the capsaicin away, where water only spreads it")
(genls Watercolor Paint) (word Watercolor "watercolor" "watercolors") (word Watercolor "watercolour" "watercolours")
(comment Watercolor "paint made of pigment in gum, thinned with water and laid on paper in thin, clear washes, so the white of the paper shines through")
(prop Watercolor techniques "wet on wet, for soft edges, wet on dry, for sharp ones, a flat or graded wash, glazing one dry layer over another, and lifting colour off with a damp brush")
(genls Crescendo MusicalTerm) (genls MusicalTerm Word) (word Crescendo "crescendo" "crescendos") (word MusicalTerm "musical term" "musical terms")
(comment Crescendo "a gradual growing louder in music, written cresc. or as a widening wedge. From Italian, \"growing.\" Its opposite is a diminuendo")
(genls Diminuendo MusicalTerm) (word Diminuendo "diminuendo" "diminuendos") (comment Diminuendo "a gradual growing softer in music. Its opposite is a crescendo")
; a body is the whole living frame, not a person (User1's report, 3 xi 2026)
(word WholeBody "body" "bodies") (comment WholeBody "the whole physical frame of a living thing, as a person or an animal has")
